# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/unistay?retryWrites=true&w=majority

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here

# OTP Configuration
OTP_EXPIRY_MINUTES=10

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Payment Gateway (Mock/Placeholder)
PAYMENT_API_KEY=your_payment_api_key_here
PAYMENT_SECRET=your_payment_secret_here
